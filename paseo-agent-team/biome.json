{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!coverage",
      "!!paseo-plugin.d.ts",
      "!!.paseo-dev",
      "!!.es-launch"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@getpaseo/protocol": "Use the public plugin SDK instead of @getpaseo/protocol.",
              "@getpaseo/server": "Use @getpaseo/plugin/server instead of @getpaseo/server.",
              "@getpaseo/client": "Depend on the structural PaseoPort (shared/paseo/port.ts); the host compiler cannot resolve @getpaseo/client types.",
              "@getpaseo/client/internal": "Do not import @getpaseo/client/internal.",
              "@getpaseo/plugin/client/host": "Private to the Paseo app host."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
