{
  "name": "@omercnet/paseo-gas-city",
  "version": "0.1.0",
  "type": "module",
  "description": "A Paseo control plane for observing and operating Gas City supervisors.",
  "license": "MIT",
  "author": "Omer Cohen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercnet/paseo-plugins.git",
    "directory": "paseo-gas-city"
  },
  "homepage": "https://github.com/omercnet/paseo-plugins/tree/main/paseo-gas-city#readme",
  "bugs": {
    "url": "https://github.com/omercnet/paseo-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "gas-city",
    "orchestration",
    "gastown",
    "beads",
    "multi-agent",
    "software-factory",
    "coding-agents"
  ],
  "files": [
    "CHANGELOG.md",
    "icon.svg",
    "LICENSE",
    "README.md",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "docs",
    "server",
    "shared",
    "paseo-plugin.json"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.thresholds.lines=90 --coverage.thresholds.functions=85 --coverage.exclude=index.client.tsx --coverage.exclude=index.server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.scripts.json",
    "package:release": "node scripts/package-release.ts",
    "verify:package": "node scripts/verify-package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@getpaseo/cli": "0.8.0",
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@tanstack/react-query": "^5.102.3",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.0",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0",
    "zod": "^4.4.3"
  }
}
