{
  "name": "@omercnet/paseo-shared-browser",
  "version": "0.3.0",
  "private": true,
  "description": "One real Chromium session per Paseo workspace, shared live across every connected client.",
  "keywords": [
    "browser",
    "chromium",
    "coding-agents",
    "paseo",
    "paseo-plugin",
    "remote-browser"
  ],
  "license": "MIT",
  "author": "Omer Cohen",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt . '!CHANGELOG.md'",
    "format:check": "oxfmt --check . '!CHANGELOG.md'",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:unit": "vitest run tests/contracts.test.ts tests/lease.test.ts tests/runtime-lifecycle.test.ts tests/agent-access.test.ts",
    "test:smoke": "vitest run tests/browser.smoke.test.ts --testTimeout=30000"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "agent-browser": "0.37.1"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "agent-browser": true,
    "esbuild@0.28.2": true
  }
}
